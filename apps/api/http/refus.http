# ⚠ La réponse ne doit PAS contenir LICORNE.
POST {{baseUrl}}/account
Content-Type: application/json

{
  "email": "delivered+avatar@resend.dev",
  "password": "Barla2026!",
  "humanProof": {{preuveFactice}},
