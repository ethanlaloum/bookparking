# Cible : local (defaut) ou dev
E2E_TARGET=local

# Port fixe de l'api demarree par globalSetup. Fixe et non aleatoire : la
# section `webServer` de playwright.config.ts est evaluee au chargement du
# fichier, avant que globalSetup ne s'execute, donc elle ne peut pas lire un
# port tire au sort.
E2E_API_PORT=3100
E2E_FRONT_PORT=5174

# Reattache la suite a une api et un front deja demarres sur ces ports.
E2E_LOCAL_REUSE_STACK=false

# Cible `dev` uniquement
E2E_DEV_FRONT_URL=
E2E_DEV_API_URL=
