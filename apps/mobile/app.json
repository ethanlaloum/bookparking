{
  "expo": {
    "name": "Bookparking",
    "slug": "bookparking",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "bookparking",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0b0d12",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.bookparking.app"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Bookparking ouvre vos photos pour illustrer la place que vous publiez.",
          "cameraPermission": "Bookparking utilise l’appareil photo pour photographier la place que vous publiez.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
