{
  "schemaVersion": 3,
  "project": {
    "name": "Bookparking",
    "slug": "bookparking",
    "root": "/Users/ethanlaloum/dev/bookparking"
  },
  "repo": {
    "layout": "monorepo",
    "slug": "ethanlaloum/bookparking",
    "defaultBranch": "main",
    "packageManager": "pnpm"
  },
  "apps": [
    {
      "name": "api",
      "path": "apps/api",
      "role": "backend",
      "rungs": [
        "unit",
        "int-repo",
        "int-http",
        "journey"
      ],
      "commands": {},
      "testGlobs": {
        "unit": "src/**/*.unit.spec.ts",
        "int-repo": "src/**/adapters/{repositories,services}/**/*.int.spec.ts",
        "int-http": "src/**/adapters/rest/**/*.int.spec.ts",
        "journey": "src/**/*.journey.int.spec.ts"
      }
    },
    {
      "name": "front",
      "path": "apps/front",
      "role": "frontend",
      "rungs": [
        "unit"
      ],
      "commands": {},
      "testGlobs": {
        "unit": "src/**/*.unit.spec.ts"
      }
    },
    {
      "name": "bo",
      "path": "apps/bo",
      "role": "frontend",
      "rungs": [
        "unit"
      ],
      "commands": {},
      "testGlobs": {
        "unit": "src/**/*.unit.spec.ts"
      }
    },
    {
      "name": "e2e",
      "path": "apps/e2e",
      "role": "e2e",
      "rungs": [
        "e2e"
      ],
      "commands": {},
      "testGlobs": {
        "e2e": "tests/real/**/*.spec.ts"
      }
    }
  ],
  "specs": {
    "mode": "embedded",
    "root": "docs"
  },
  "github": {
    "issues": true,
    "milestones": true,
    "labels": true,
    "subIssues": true
  },
  "quality": {
    "conventions": true,
    "security": true,
    "compliance": {
      "enabled": true,
      "frameworks": [
        "RGPD"
      ],
      "dataClasses": [
        "pii",
        "financial"
      ],
      "notes": "Bookparking est une place de marché de stationnement entre particuliers à Nice. L'exploitant encaisse le conducteur, prélève une commission et reverse le loueur : il traite donc l'identité vérifiée des loueurs (pièce d'identité, IBAN) et les données de paiement des conducteurs. La vérification d'identité n'est déclenchée qu'avant le premier versement, jamais pour publier une annonce. L'adresse exacte d'une place est publique sur l'annonce avant toute réservation, par décision produit assumée : ce point est à réexaminer à chaque story qui expose une annonce."
    },
    "documentation": {
      "developer": true,
      "user": true,
      "adr": true,
      "openapi": false
    }
  },
  "workflow": {
    "build": {
      "mode": "autonomous"
    },
    "gates": {
      "perStory": false,
      "artifactPr": false
    },
    "sync": {
      "onRemovedExample": "ask",
      "openPr": true
    },
    "brainstorm": {
      "maxQuestions": 25
    }
  },
  "notion": {
    "enabled": false
  },
  "ux": {
    "outputs": [
      "markdown"
    ],
    "viewports": [
      "mobile",
      "desktop"
    ]
  },
  "guard": {
    "enabled": true
  }
}
