{
	admin off
	auto_https off
}

# Railway donne le port dans $PORT et termine le HTTPS en amont.
:{$PORT:8080} {
	encode zstd gzip

	# L'api, jointe par le réseau privé de Railway ($API_INTERNAL_URL, par
	# exemple http://api.railway.internal:3000). `handle_path` retire /api,
	# comme la réécriture du proxy de Vite.
	handle_path /api/* {
		reverse_proxy {$API_INTERNAL_URL}
	}

	handle {
		root * /srv

		# Les fichiers de Vite portent leur empreinte : ils ne changent jamais.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		# Application monopage : toute adresse inconnue reçoit index.html, et la
		# page 404 du site s'en charge (elle pose `noindex` elle-même).
		try_files {path} /index.html
		file_server
	}
}
