### Parcours complet — IntelliJ HTTP Client
# Sélectionne l'environnement « local » en haut à droite, puis lance les requêtes dans l'ordre.
# Rien à copier à la main : le script de l'étape 1 résout le défi anti-robot, et le jeton,
# l'annonce et les demandes sont capturés au passage.
# Chaque passage inscrit un nouveau compte, à une adresse de test de Resend
# (delivered+…@resend.dev) : l'e-mail de bienvenue est simulé, rien ne rebondit.

### 0 · Obtenir un défi anti-robot · attendu 200
GET {{baseUrl}}/account/human-challenge

> {%
    client.test("un défi est rendu", function() {
        client.assert(response.status === 200, "attendu 200, reçu " + response.status);
    });
    client.global.set("challenge", response.body.challenge);
    client.global.set("challengeSalt", response.body.salt);
    client.global.set("challengeSignature", response.body.signature);
    client.global.set("challengeMaxNumber", String(response.body.maxNumber));
%}

### 1 · S'inscrire · attendu 201
# Le script cherche le nombre dont le SHA-256 redonne le défi : quelques secondes au plus.
# Une preuve ne sert qu'une fois : relancer l'étape 0 avant de rejouer celle-ci.
< {%
    const challenge = client.global.get("challenge");
    const salt = client.global.get("challengeSalt");
    const maxNumber = Number(client.global.get("challengeMaxNumber"));
    let number = 0;
    while (number <= maxNumber
        && crypto.sha256().updateWithText(salt + number).digest().toHex() !== challenge) number++;
    const email = "delivered+marc-" + Date.now() + "@resend.dev";
    request.variables.set("proofNumber", String(number));
    request.variables.set("accountEmail", email);
    client.global.set("accountEmail", email);
%}
POST {{baseUrl}}/account
Content-Type: application/json

{
  "email": "{{accountEmail}}",
  "password": "{{password}}",
  "humanProof": {
    "algorithm": "SHA-256",
    "challenge": "{{challenge}}",
    "salt": "{{challengeSalt}}",
    "number": {{proofNumber}},
    "signature": "{{challengeSignature}}"
  },
  "acceptsTerms": true,
  "avatar": "SIGNAL"
}

> {%
    client.test("le compte est créé", function() {
        client.assert(response.status === 201, "attendu 201, reçu " + response.status);
        client.assert(response.body.id !== undefined, "aucun identifiant rendu");
    });
    client.global.set("accountId", response.body.id);
%}

### 2 · Se connecter · attendu 200 + un jeton signé
POST {{baseUrl}}/session
Content-Type: application/json

{
  "email": "{{accountEmail}}",
  "password": "{{password}}"
}

> {%
    client.test("un jeton est délivré", function() {
        client.assert(response.status === 200, "attendu 200, reçu " + response.status);
        client.assert(response.body.token !== undefined, "aucun jeton");
    });
    client.global.set("token", response.body.token);
%}

### 3 · Lire son compte · attendu 200
GET {{baseUrl}}/account
Authorization: Bearer {{token}}

> {%
    client.test("le compte est celui du jeton", function() {
        client.assert(response.status === 200, "attendu 200, reçu " + response.status);
        client.assert(response.body.email === client.global.get("accountEmail"), "autre adresse");
        client.assert(response.body.avatar === "SIGNAL", "avatar inattendu : " + response.body.avatar);
    });
%}

