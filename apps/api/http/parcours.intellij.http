# Les dates sont rendues aussitôt.
POST {{baseUrl}}/rental-request/{{requestId}}/abandonment
Authorization: Bearer {{token}}

> {%
    client.test("la demande est abandonnée", function() {
        client.assert(response.status === 204, "attendu 204, reçu " + response.status);
    });
%}

