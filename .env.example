# Clé de signature des jetons d'accès. Sans elle, l'API refuse de démarrer :
# aucune valeur de repli n'existe (SPEC-002, §8).
ACCESS_TOKEN_SECRET=change-moi-en-production

# Connexion Postgres. Sans elle, l'API refuse de démarrer.
DATABASE_URL=postgres://bp:bp@localhost:55432/bookparking

# Port d'écoute, 3000 par défaut.
PORT=3000

# Délai au-delà duquel une demande de location non confirmée par le loueur
# expire et cesse de geler la place, en heures. 48 par défaut.
# Question Q-18 du brainstorm, laissée ouverte : à trancher en back-office.
RENTAL_REQUEST_EXPIRY_IN_HOURS=48

# --- E-mails (SPEC-006) ---------------------------------------------------
# Copier ce fichier en `.env` à la racine du dépôt : `pnpm --filter bookparking-api start`
# le charge s'il existe. `.env` est ignoré par git ; ne jamais y commiter de clé.

# Clé d'api Resend. Sans elle, l'API refuse de démarrer, sauf EMAIL_SENDING=disabled.
RESEND_API_KEY=
# Expéditeur, sur un domaine vérifié chez Resend : « Nom <adresse@domaine> ».
MAIL_FROM=Bookparking <bonjour@exemple.fr>
# `disabled` : aucun e-mail ne part, ils restent en file (parcours e2e, développement sans clé).
# EMAIL_SENDING=disabled
# Intervalle du balayage de la file d'e-mails, en secondes. 30 par défaut.
# EMAIL_SWEEP_INTERVAL_IN_SECONDS=30
