{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/front/Dockerfile",
    "watchPatterns": ["/apps/front/**", "/pnpm-lock.yaml", "/pnpm-workspace.yaml"]
  },
  "deploy": {
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE"
  }
}
