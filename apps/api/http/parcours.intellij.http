### 5 · Publier une annonce · attendu 201, sans corps
# Disponible de J+7 à J+60, sous un box tiré au hasard.
< {%
    const day = function(offset) {
        return new Date(Date.now() + offset * 86400000).toISOString().slice(0, 10);
    };
    const keep = function(name, value) {
        request.variables.set(name, value);
        client.global.set(name, value);
    };
    keep("listingBox", "B" + (100 + Math.floor(Math.random() * 900)));
    keep("availableFrom", day(7));
    keep("availableTo", day(60));
    keep("fromDay", day(10));
    keep("toDay", day(12));
%}
POST {{baseUrl}}/listing
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "address": "12 rue Barla, 06300 Nice",
  "box": "{{listingBox}}",
  "accessDescription": "portail bleu à gauche du 12, le box est au fond du premier sous-sol",
  "photos": ["photo-1.jpg"],
  "acceptedVehicles": ["voiture", "electrique"],
  "pricing": { "dayInCents": 1200, "weekInCents": 6000, "monthInCents": 18000 },
  "availability": { "from": "{{availableFrom}}", "to": "{{availableTo}}" }
}

> {%
    client.test("l'annonce est publiée", function() {
        client.assert(response.status === 201, "attendu 201, reçu " + response.status);
    });
%}

### 6 · Lister ses annonces · attendu 200 · l'identifiant est ici
GET {{baseUrl}}/listing/mine
Authorization: Bearer {{token}}

> {%
    const box = client.global.get("listingBox");
    const listing = response.body.find(function(annonce) { return annonce.box === box; });
    client.test("l'annonce publiée est dans la liste", function() {
        client.assert(response.status === 200, "attendu 200, reçu " + response.status);
        client.assert(listing !== undefined, "aucune annonce au box " + box);
        client.assert(listing.status === "ACTIVE", "statut inattendu : " + listing.status);
    });
    client.global.set("listingId", listing.id);
%}

### 7 · Lister toutes les places disponibles, sans compte · attendu 200
GET {{baseUrl}}/listing

> {%
    client.test("la liste est publique et ne fuit rien", function() {
        client.assert(response.status === 200, "attendu 200, reçu " + response.status);
        client.assert(Array.isArray(response.body), "un tableau est attendu");
        response.body.forEach(function(annonce) {
            client.assert(annonce.accessDescription === undefined,
                "la description d'accès ne doit jamais être publique");
        });
    });
%}

### 8 · Relire l'annonce, sans compte · attendu 200 · SPEC-002 EX-11
GET {{baseUrl}}/listing/{{listingId}}

> {%
    client.test("l'annonce est lisible sans compte", function() {
        client.assert(response.status === 200, "attendu 200, reçu " + response.status);
        client.assert(response.body.accessDescription === undefined,
            "la description d'accès ne doit jamais être publique");
    });
%}

### 9 · Changer ses tarifs · attendu 200 + l'annonce à jour
# Un palier omis est retiré de la grille : le mois revient à null.
PATCH {{baseUrl}}/listing/{{listingId}}/pricing
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "dayInCents": 1500,
  "weekInCents": 8000
}

> {%
    client.test("la grille est remplacée", function() {
        client.assert(response.status === 200, "attendu 200, reçu " + response.status);
        client.assert(response.body.pricing.dayInCents === 1500, "tarif du jour inattendu");
        client.assert(response.body.pricing.monthInCents === null, "le mois devait disparaître");
    });
%}

### 10 · Demander la place · attendu 201 + l'identifiant et la page de paiement
# L'en-tête Idempotency-Key est obligatoire : un UUID par intention de louer.
< {%
    const intent = "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(/[xy]/g, function(c) {
        const r = Math.floor(Math.random() * 16);
        return (c === "x" ? r : (r & 0x3) | 0x8).toString(16);
    });
    request.variables.set("intent", intent);
    client.global.set("intent", intent);
%}
POST {{baseUrl}}/rental-request
Content-Type: application/json
Authorization: Bearer {{token}}
Idempotency-Key: {{intent}}

{
  "address": "12 rue Barla, 06300 Nice",
  "box": "{{listingBox}}",
  "fromDay": "{{fromDay}}",
  "toDay": "{{toDay}}"
}

> {%
    client.test("la demande attend son paiement", function() {
        client.assert(response.status === 201, "attendu 201, reçu " + response.status);
        client.assert(response.body.checkoutUrl.indexOf("https://checkout.stripe.com/") === 0,
            "aucune page de paiement Stripe");
    });
    client.global.set("requestId", response.body.id);
%}

### 11 · Rejouer la même demande · attendu 201, même identifiant, en-tête Idempotent-Replayed: true
# Un double clic ne fait pas deux demandes.
POST {{baseUrl}}/rental-request
Content-Type: application/json
Authorization: Bearer {{token}}
Idempotency-Key: {{intent}}

{
  "address": "12 rue Barla, 06300 Nice",
  "box": "{{listingBox}}",
  "fromDay": "{{fromDay}}",
  "toDay": "{{toDay}}"
}

> {%
    client.test("la même demande est rendue", function() {
        client.assert(response.status === 201, "attendu 201, reçu " + response.status);
        client.assert(response.body.id === client.global.get("requestId"), "une seconde demande a été créée");
        client.assert(response.headers.valueOf("Idempotent-Replayed") === "true",
            "l'en-tête Idempotent-Replayed manque");
    });
%}

### 12 · Lister ses demandes · attendu 200 · statut AWAITING_PAYMENT
GET {{baseUrl}}/rental-request
Authorization: Bearer {{token}}

> {%
    const id = client.global.get("requestId");
    const demande = response.body.find(function(d) { return d.id === id; });
    client.test("la demande attend son paiement", function() {
        client.assert(response.status === 200, "attendu 200, reçu " + response.status);
        client.assert(demande !== undefined, "la demande n'est pas dans la liste");
        client.assert(demande.status === "AWAITING_PAYMENT", "statut inattendu : " + demande.status);
    });
%}

