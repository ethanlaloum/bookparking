< {%
    const intent = "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(/[xy]/g, function(c) {
        const r = Math.floor(Math.random() * 16);
        return (c === "x" ? r : (r & 0x3) | 0x8).toString(16);
    });
    request.variables.set("intent", intent);
%}
POST {{baseUrl}}/rental-request
Content-Type: application/json
Authorization: Bearer {{token}}
Idempotency-Key: {{intent}}

{
  "address": "12 rue Barla, 06300 Nice",
  "box": "{{listingBox}}",
  "fromDay": "{{fromDay}}",
  "toDay": "{{toDay}}"
}

> {%
    client.test("les dates abandonnées sont libres", function() {
        client.assert(response.status === 201, "attendu 201, reçu " + response.status);
    });
    client.global.set("paidRequestId", response.body.id);
    client.log("Page de paiement : " + response.body.checkoutUrl);
%}

### 15 · Payer : ouvrir la page de paiement dans le navigateur
# L'adresse est dans le journal de l'étape 14. Carte de test 4242 4242 4242 4242, n'importe
# quelle date future et n'importe quel code. C'est l'événement de Stripe, relayé par
# `stripe listen` (voir le README), qui fait passer la demande PENDING — pas le retour du
# navigateur. Sans paiement, les étapes 16 à 18 échouent : liste vide, 404, puis 409.

### 16 · Lister les demandes reçues sur ses places · attendu 200 · statut PENDING
# Le compte loue ici sa propre place : il est à la fois conducteur et loueur.
GET {{baseUrl}}/rental-request/received
Authorization: Bearer {{token}}

> {%
    const id = client.global.get("paidRequestId");
    const demande = response.body.find(function(d) { return d.id === id; });
    client.test("la demande payée attend le loueur", function() {
        client.assert(response.status === 200, "attendu 200, reçu " + response.status);
        client.assert(demande !== undefined, "demande absente : a-t-elle été payée ?");
        client.assert(demande.status === "PENDING", "statut inattendu : " + demande.status);
    });
%}

