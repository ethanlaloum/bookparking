# Clé de signature des jetons d'accès. Sans elle, l'API refuse de démarrer :
# aucune valeur de repli n'existe (SPEC-002, §8).
ACCESS_TOKEN_SECRET=change-moi-en-production

# Connexion Postgres. Sans elle, l'API refuse de démarrer.
DATABASE_URL=postgres://bp:bp@localhost:55432/bookparking

# Port d'écoute, 3000 par défaut.
PORT=3000

# Délai au-delà duquel une demande de location non confirmée par le loueur
# expire et cesse de geler la place, en heures. 48 par défaut.
# Question Q-18 du brainstorm, laissée ouverte : à trancher en back-office.
RENTAL_REQUEST_EXPIRY_IN_HOURS=48
